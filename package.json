{
  "name": "hexiva",
  "version": "0.1.0",
  "private": true,
  "description": "Hexiva mobile-first 3D puzzle game",
  "scripts": {
    "build:web": "node scripts/build-offline.mjs",
    "build:css": "tailwindcss -c tailwind.config.cjs -i src/tailwind.css -o dist/app.css --minify",
    "android:add": "npm run build:web && npx cap add android && node scripts/configure-android.mjs",
    "android:sync": "npm run build:web && npx cap sync android && node scripts/configure-android.mjs",
    "android:open": "npx cap open android",
    "verify:source": "node scripts/verify-source.mjs",
    "android:debug": "npm run android:sync && node scripts/build-android-debug.mjs",
    "catalog:build": "node scripts/build-catalog.cjs",
    "audit:catalog": "node scripts/audit-catalog.cjs",
    "test": "node --test tests/*.test.cjs",
    "catalog:anne-preview": "node scripts/build-anne-grid-catalog.cjs",
    "audit:anne-preview": "node scripts/audit-catalog.cjs src/catalog-anne-grid-preview.js 1250",
    "catalog:anne-promote": "node scripts/promote-anne-grid-preview.cjs",
    "smoke:anne-grid": "node scripts/smoke-anne-grid.cjs 4",
    "probe:anne-grid-mechanics": "node scripts/probe-anne-grid-mechanics.cjs"
  },
  "dependencies": {
    "@tweenjs/tween.js": "18.6.4",
    "three": "0.128.0",
    "tone": "14.8.49",
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor-community/speech-recognition": "7.0.1"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17",
    "@capacitor/cli": "8.5.2"
  }
}
